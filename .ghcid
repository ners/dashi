--warnings
--directory=static
--color=always
--command "cabal repl --repl-options=-fno-break-on-exception --repl-options=-fno-break-on-error --repl-options=-v1 --repl-options=-ferror-spans --repl-options=-j --repl-options=-fdiagnostics-color=always --enable-multi-repl exe:dashi lib:dashi"
--test=Main.main
